# STAGING environment variables (GitHub Pages / Vite build-time)
# These are PUBLIC (anon) values only — never put service_role or secrets here.
# In the staging repo, set the two VITE_SUPABASE_* values as Actions secrets
# (Settings -> Secrets and variables -> Actions), NOT committed to git.

# --- Staging Supabase project (created separately; NOT production) ---
VITE_SUPABASE_URL=https://<STAGING-PROJECT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<STAGING-ANON-KEY>

# --- App identity (safe to commit / hardcode in workflow) ---
VITE_APP_NAME=TPS Operations (STAGING)
VITE_APP_URL=https://staging.tpsxpert.com

# NOTE: Production values (portal.tpsxpert.com + muxwwvwmephtwghsrzbp) are NEVER
# used here. Staging points only at the new staging Supabase project.
